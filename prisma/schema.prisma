generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdvocateCase {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id])
  role          String?  
  internalNotes String?
  addedAt       DateTime @default(now())

  @@unique([userId, caseId])
}

model Case {
  id              String    @id @default(uuid())
  cnrNumber       String?   @unique
  caseNumber      String?
  title           String
  type            String
  court           String
  judge           String?   
  status          String
  source          String    @default("ecourts")
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hearings        Hearing[]
  advocateCases   AdvocateCase[]
}

model Judge {
  id           String      @id @default(uuid())
  name         String      @unique
  courtrooms   Courtroom[]
  hearings     Hearing[]
}

model Courtroom {
  id           String   @id @default(uuid())
  room         String   @unique
  judgeId      String?
  judge        Judge?   @relation(fields: [judgeId], references: [id])
  status       String
  currentCase  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  hearings     Hearing[]
}

model Hearing {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  
  courtroomId String?
  courtroom   Courtroom? @relation(fields: [courtroomId], references: [id])
  judgeId     String?
  judge       Judge?     @relation(fields: [judgeId], references: [id])
  
  date        String
  time        String?
  room        String?    
  judgeName   String?    
  status      String
  source      String     @default("ecourts")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  court        String?
  designation  String?
  role         String
  passwordHash String?
  createdAt    DateTime  @default(now())

  sessions      Session[]
  advocateCases AdvocateCase[]
}

model Session {
  token      String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Profile {
  role       String   @id
  name       String?
  profileId  String?
  phone      String?
  court      String?
  alerts     Boolean  @default(true)
}

model Document {
  id         String   @id @default(uuid())
  date       String
  status     String
  name       String?
  caseNumber String?
  type       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Filing {
  id         String   @id @default(uuid())
  status     String
  title      String?
  caseNumber String?
  type       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
